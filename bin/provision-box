#!/usr/bin/env bash
set -Eeuo pipefail

readonly MANAGED_BEGIN="# BEGIN agent_coding_bench box"
readonly MANAGED_END="# END agent_coding_bench box"
readonly SSH_CONFIG_FILE="${SSH_CONFIG_FILE:-${HOME}/.ssh/config}"
readonly REMOTE_PROVISIONER="/root/agent-coding-bench-provision.sh"
readonly -a SSH_NO_FORWARD_OPTIONS=(
  -o ClearAllForwardings=yes
  -o ControlMaster=no
  -o ControlPath=none
)

usage() {
  cat <<'EOF'
Usage: bin/provision-box <ipv4-address>

Provision a fresh AMD Dev Cloud box, update the managed `Host box` SSH config,
and open local vLLM and opencode tunnels on ports 8000 and 4096.
EOF
}

die() {
  printf 'ERROR: %s\n' "$*" >&2
  exit 1
}

valid_ipv4() {
  local candidate="$1"
  local octet
  local -a octets

  [[ "$candidate" =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}$ ]] || return 1
  IFS=. read -r -a octets <<< "$candidate"

  for octet in "${octets[@]}"; do
    ((10#$octet <= 255)) || return 1
  done
}

require_command() {
  command -v "$1" >/dev/null 2>&1 || die "Required command not found: $1"
}

stop_existing_tunnel() {
  if [[ -f "$SSH_CONFIG_FILE" ]] && grep -Fq "$MANAGED_BEGIN" "$SSH_CONFIG_FILE"; then
    ssh -F "$SSH_CONFIG_FILE" -O exit box >/dev/null 2>&1 || true
  fi
}

write_ssh_config() {
  local box_ip="$1"
  local config_directory
  local filtered_config

  config_directory="$(dirname "$SSH_CONFIG_FILE")"
  mkdir -p "$config_directory"
  filtered_config="$(mktemp "${config_directory}/config.agent-coding-bench.XXXXXX")"

  if [[ -f "$SSH_CONFIG_FILE" ]]; then
    awk -v managed_begin="$MANAGED_BEGIN" -v managed_end="$MANAGED_END" '
      $0 == managed_begin { managed = 1; next }
      $0 == managed_end { managed = 0; next }
      !managed { print }
    ' "$SSH_CONFIG_FILE" > "$filtered_config"
  fi

  if [[ -s "$filtered_config" ]] && [[ "$(tail -c 1 "$filtered_config" 2>/dev/null || true)" != "" ]]; then
    printf '\n' >> "$filtered_config"
  fi

  cat >> "$filtered_config" <<EOF
$MANAGED_BEGIN
Host box
  HostName $box_ip
  User root
  Port 22
  ControlMaster auto
  ControlPath ~/.ssh/control-%C
  ControlPersist 10m
  ServerAliveInterval 15
  ServerAliveCountMax 3
  StrictHostKeyChecking accept-new
  LocalForward 8000 127.0.0.1:8000
  LocalForward 4096 127.0.0.1:4096
$MANAGED_END
EOF

  chmod 600 "$filtered_config"
  mv "$filtered_config" "$SSH_CONFIG_FILE"
}

wait_for_ssh() {
  local attempts=0

  printf 'Waiting for SSH'
  until ssh -F "$SSH_CONFIG_FILE" "${SSH_NO_FORWARD_OPTIONS[@]}" -o ConnectTimeout=10 box true >/dev/null 2>&1; do
    attempts=$((attempts + 1))
    ((attempts < 30)) || die "SSH did not become ready after 5 minutes"
    printf '.'
    sleep 10
  done
  printf ' ready\n'
}

port_available() {
  local port="$1"

  if lsof -nP -iTCP:"$port" -sTCP:LISTEN >/dev/null 2>&1; then
    die "Local port $port is already in use; stop its listener before provisioning"
  fi
}

wait_for_endpoint() {
  local url="$1"
  local name="$2"
  local attempts=0

  until curl --fail --silent --show-error "$url" >/dev/null; do
    attempts=$((attempts + 1))
    ((attempts < 12)) || die "$name did not answer through the SSH tunnel"
    sleep 2
  done
}

main() {
  [[ $# -eq 1 ]] || {
    usage >&2
    exit 1
  }

  case "$1" in
    -h|--help)
      usage
      exit 0
      ;;
  esac

  local box_ip="$1"
  local script_directory
  local repo_root
  local provisioner

  valid_ipv4 "$box_ip" || die "Expected an IPv4 address, got: $box_ip"

  for command_name in ssh scp ssh-keygen curl lsof awk; do
    require_command "$command_name"
  done

  script_directory="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
  repo_root="$(cd "${script_directory}/.." && pwd)"
  provisioner="${repo_root}/box/provision.sh"
  [[ -f "$provisioner" ]] || die "Remote provisioner not found: $provisioner"

  stop_existing_tunnel
  write_ssh_config "$box_ip"

  ssh-keygen -R "$box_ip" >/dev/null 2>&1 || true
  ssh-keygen -R "[$box_ip]:22" >/dev/null 2>&1 || true

  wait_for_ssh

  printf 'Copying remote provisioner...\n'
  scp -F "$SSH_CONFIG_FILE" "${SSH_NO_FORWARD_OPTIONS[@]}" "$provisioner" "box:$REMOTE_PROVISIONER"

  printf 'Provisioning the box (model download and vLLM startup take several minutes)...\n'
  ssh -F "$SSH_CONFIG_FILE" "${SSH_NO_FORWARD_OPTIONS[@]}" box "bash $REMOTE_PROVISIONER"
  ssh -F "$SSH_CONFIG_FILE" "${SSH_NO_FORWARD_OPTIONS[@]}" box "rm -f $REMOTE_PROVISIONER"

  port_available 8000
  port_available 4096

  printf 'Opening SSH tunnels...\n'
  ssh -F "$SSH_CONFIG_FILE" -fN -o ExitOnForwardFailure=yes box

  wait_for_endpoint "http://127.0.0.1:8000/metrics" "vLLM"
  wait_for_endpoint "http://127.0.0.1:4096/doc" "opencode"

  cat <<'EOF'

Box ready.
  vLLM:    http://127.0.0.1:8000
  opencode: http://127.0.0.1:4096
  SSH:     ssh box

Start Phoenix/Postgres locally, then start a one-Lane World from the dashboard.
EOF
}

main "$@"
